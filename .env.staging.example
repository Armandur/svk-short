# Kopiera till .env.staging. Checka ALDRIG in .env.staging.
#
# Staging har produktionens SÄKERHET men ingen av dess UTGÅENDE verkningar.
# All post fångas av Mailpit, se docker-compose.staging.yml.

DATABASE_PATH=data/links.db

# EGEN nyckel, aldrig produktionens. Generera:
#   openssl rand -hex 32
SECRET_KEY=

# Adressen tailscale serve publicerar staging på. Se docs/staging.md.
# Måste vara https, annars sätts sessionscookien utan Secure-flagga och
# staging slutar likna produktionen på just den punkt som är värd att prova.
BASE_URL=https://svky-server.ussuri-tawny.ts.net:8443

# EGET namn. Prod och staging delar inte domän, men ett eget namn gör att en
# session i den ena aldrig kan förväxlas med den andra i felsökning.
SESSION_COOKIE_NAME=session_staging

# Avsändare i den fångade posten. Ingen riktig brevlåda tar emot den.
MAIL_FROM=link@svky.staging.invalid

# SMTP_HOST, SMTP_PORT, SMTP_SECURITY, SMTP_USER och SMTP_PASS sätts av
# docker-compose.staging.yml och ska INTE stå här. Sätts de här vinner de
# över compose-filen, och då kan staging nå Lettermint.
