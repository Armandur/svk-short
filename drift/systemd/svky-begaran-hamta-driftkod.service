[Unit]
StartLimitIntervalSec=0
Description=Hämta ny driftkod till utcheckningen

[Service]
Type=oneshot
# + kör steget med fulla rättigheter, oavsett User=. Markören ägs av
# svky-ops i en katalog svky-ops äger, så en enhet som kör som rasmus
# får Permission denied - och fastnar i rm, med markören kvar och
# knappen tyst död. Gäller de enheter som INTE kör som root, men sätts
# på alla fyra: en enhet som senare byter användare ska inte tysta
# knappen som bieffekt.
# En KÖRMARKÖR, inte bara en raderad begäran. Markören i begaran/ försvinner
# innan jobbet ens börjat, och sidan hade då inget sätt att se att något
# pågick - promoteringen såg avslutad ut efter en sekund och fick beskedet
# "produktionens version är oförändrad" medan den fortfarande bytte version.
# Ytan får läsa filen, aldrig skriva den. 644 uttryckligen: enheten kör som
# root, och en markör ytan inte kan läsa är samma sak som ingen markör.
ExecStartPre=+/bin/sh -c 'install -d -m 755 /var/lib/svky/korande && install -m 644 /dev/null /var/lib/svky/korande/hamta-driftkod && rm -f /var/lib/svky/begaran/hamta-driftkod'

# Git körs som den som ÄGER utcheckningen, inte som root. Klonen hämtas över
# SSH med ägarens nyckel, och root har ingen sådan - som root faller varje
# fetch på Permission denied (publickey), vilket ser ut som ett nätfel men är
# en identitetsfråga.
User=rasmus
WorkingDirectory=/home/rasmus/svk-short
ExecStart=/home/rasmus/svk-short/drift/svky-hamta-driftkod.sh

# ProtectHome=read-only, inte yes: med yes döljs hemkatalogen där ssh-nyckeln
# ligger. Skrivrätten är smal - .git för fetch och merge, och arbetsträdet
# eftersom en ff-merge byter ut filer där.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/rasmus/svk-short
TimeoutStartSec=120
# Städa markören OCH be samlaren läsa om läget direkt. Utan det andra steget
# jämför sidan mot en lägesfil som kan vara en minut gammal, och ger samma
# falska "oförändrad" som förut - bara en minut senare.
ExecStopPost=+/bin/sh -c 'rm -f /var/lib/svky/korande/hamta-driftkod; systemctl start --no-block svky-samla-lage.service'
