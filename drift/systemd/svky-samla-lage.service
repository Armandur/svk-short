[Unit]
Description=Samla svky driftläge till lägesfilen
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=rasmus
WorkingDirectory=/home/rasmus/svk-short
ExecStart=/home/rasmus/svk-short/drift/svky-samla-lage.sh

# Valfri: en fine-grained GitHub-token med ENDAST Actions: read, som
# SVKY_GITHUB_TOKEN. Saknas den blir CI-fältet null och ytan säger att den
# inte vet - vilket är sant, och inte samma sak som att bygget är grönt.
EnvironmentFile=-/home/rasmus/.config/svky-drift.env

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/svky
# git fetch skriver .git/FETCH_HEAD. ProtectHome=read-only stoppade den, och
# felet kom som "Read-only file system" - vilket ser ut som ett diskfel.
# ENBART .git, inte utcheckningen: samlaren ska kunna hämta referenser, aldrig
# röra arbetsträdet.
ReadWritePaths=/home/rasmus/svk-short/.git
StateDirectory=svky
TimeoutStartSec=60
