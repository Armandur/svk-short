[Unit]
StartLimitIntervalSec=0
Description=Rulla ut driftkoden till /usr/local/bin och /etc/systemd/system

[Service]
Type=oneshot
# + kör steget med fulla rättigheter, oavsett User=. Markören ägs av
# svky-ops i en katalog svky-ops äger, så en enhet som kör som rasmus
# får Permission denied - och fastnar i rm, med markören kvar och
# knappen tyst död. Gäller de enheter som INTE kör som root, men sätts
# på alla fyra: en enhet som senare byter användare ska inte tysta
# knappen som bieffekt.
ExecStartPre=+/bin/rm -f /var/lib/svky/begaran/rulla-ut

# Som root, och HÄRDNINGEN ÄR MEDVETET LÖS. Jobbet ska skriva i /usr/local/bin
# och /etc/systemd/system och köra daemon-reload - varje ProtectSystem hade
# fällt det på filsystemet innan det hunnit göra något, och en halvkörd
# installation är sämre än ingen.
#
# Det som ändå begränsar är kedjan: ytan kan bara skriva en markörfil i en
# katalog, path-enheten tar inga argument, och vad som installeras står i
# skriptets egen lista. Ytan kan inte peka ut en fil.
WorkingDirectory=/home/rasmus/svk-short
ExecStart=/home/rasmus/svk-short/drift/svky-rulla-ut-drift.sh
TimeoutStartSec=120
