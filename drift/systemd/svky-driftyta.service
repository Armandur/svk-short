[Unit]
Description=Driftyta för svky.se
Documentation=file:///home/rasmus/svk-short/docs/staging.md
After=network.target

[Service]
# EGEN användare utan grupper. Ytan läser bara lägesfilen - ingen
# dockersocket, ingen systemctl, inga hemligheter. Den som når docker kan
# allt med varje container, och en webbyta ska inte kunna det.
User=svky-ops
Group=svky-ops
DynamicUser=yes
# Rotägd KOPIA, inte utcheckningen. Två skäl, och båda är avgörande:
# ProtectHome=yes döljer /home, så en ExecStart därifrån faller med exit 2
# (python kan inte öppna filen) - och en tjänst som kör kod ur en
# användarskrivbar katalog kan bytas ut av den som äger katalogen.
# Samma mönster som /usr/local/bin/uppetidssond.
#
# Ändras skriptet måste kopian rullas ut på nytt, se docs/staging.md.
ExecStart=/usr/bin/python3 /usr/local/bin/svky-driftyta
Restart=on-failure
RestartSec=5

Environment=SVKY_LAGESFIL=/var/lib/svky/lage.json
Environment=SVKY_DRIFTYTA_PORT=8002

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Läsrätt på lägesfilen och på skriptet. Inget mer.
ReadOnlyPaths=/var/lib/svky
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=128M

[Install]
WantedBy=multi-user.target
